{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mainframe Server Configuration",
  "type": "object",
  "properties": {
    "system": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "sysplex": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "maxConcurrentJobs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "http": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bodyLimitBytes": {
          "type": "integer",
          "minimum": 1
        },
        "auth": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "apiKeys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tcp": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "terminalPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dataPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "driver"
      ],
      "properties": {
        "driver": {
          "type": "string",
          "enum": [
            "sqlite",
            "memory"
          ]
        },
        "file": {
          "type": "string"
        },
        "autoMigrate": {
          "type": "boolean"
        },
        "autoSeed": {
          "type": "boolean"
        },
        "seedOnEmpty": {
          "type": "boolean"
        }
      }
    },
    "spreadsheet": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "excel",
            "csv"
          ]
        },
        "defaultSheet": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "query"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "query": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ]
        },
        "console": {
          "type": "boolean"
        }
      }
    }
  }
}